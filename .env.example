# Copy to .env.local for local development (that file is git-ignored).
# On Netlify, set these under Site configuration → Environment variables.

# Postgres connection string. On Netlify, paste the one Neon gives you.
DATABASE_URL=postgres://postgres:devpass@127.0.0.1:55432/ninja

# Password for the admin page at /admin/. Use a long, unique one.
ADMIN_PASSWORD=ninja@admin
