// Cloudflare settings for games.codebread.fun.
// The site is static files in public/ plus one Worker (worker/index.ts) that answers /api/*.
{
  // must match the Worker's name in the Cloudflare dashboard
  "name": "ninja-rider",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // pg and node:crypto need Node's APIs; this also puts the Worker's variables in process.env
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "games.codebread.fun", "custom_domain": true }],
  // keep DATABASE_URL and ADMIN_PASSWORD, set in the dashboard, across deploys
  "keep_vars": true,
  "observability": { "enabled": true }
}
